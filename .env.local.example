# Resend API key — get yours free at https://resend.com
# Copy this file to .env.local and fill in the value.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL for the API — set to your production domain when deploying
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Google PageSpeed Insights — powers Core Web Vitals in the site health check.
# Optional: without it the API still works but is heavily rate-limited, and the
# performance category will often show as "not assessed".
# Free key: https://console.cloud.google.com/apis/credentials
#   Enable "PageSpeed Insights API", create an API key, paste below.
PAGESPEED_API_KEY=
